/* =========================================================
   Clash Verge Windows - Premium Matte v1.0 (WIN ONLY)
   核心：不依赖毛玻璃，靠“渐变 + 内高光 + hairline + 阴影层级”做高级感
   ========================================================= */

/* ---------- Tokens ---------- */
:root{
  --accent: rgba(10,132,255,1);

  --r: 18px;
  --rs: 14px;

  --bgL:
    radial-gradient(1200px 900px at 16% 10%, rgba(160, 205, 255, 0.60), transparent 62%),
    radial-gradient(900px 700px at 82% 16%, rgba(235, 225, 255, 0.44), transparent 66%),
    linear-gradient(180deg, rgba(246, 248, 252, 0.98), rgba(232, 238, 247, 0.96));

  --bgD:
    radial-gradient(1200px 900px at 20% 12%, rgba(25, 120, 255, 0.28), transparent 66%),
    radial-gradient(900px 700px at 78% 16%, rgba(150, 120, 255, 0.16), transparent 70%),
    linear-gradient(180deg, rgba(8, 10, 14, 0.995), rgba(12, 18, 26, 0.99));

  /* 面板颜色（Win 更稳：更不透明） */
  --panelL1: rgba(255,255,255,0.92);
  --panelL2: rgba(248,250,252,0.82);

  --panelD1: rgba(22,26,34,0.92);
  --panelD2: rgba(16,20,28,0.82);

  /* hairline */
  --bdL: rgba(0,0,0,0.10);
  --bdD: rgba(255,255,255,0.12);

  /* 阴影（更像 mac 的层级） */
  --shL: 0 10px 26px rgba(0,0,0,0.10);
  --shD: 0 22px 62px rgba(0,0,0,0.62);

  /* 内高光 */
  --inL: inset 0 1px 0 rgba(255,255,255,0.80);
  --inD: inset 0 1px 0 rgba(255,255,255,0.06);

  /* 文本 */
  --txL: rgba(18,22,28,0.92);
  --txD: rgba(245,247,250,0.92);

  /* 选中态 */
  --selL: rgba(10,132,255,0.18);
  --selD: rgba(10,132,255,0.28);
  --selBdL: rgba(10,132,255,0.34);
  --selBdD: rgba(140,190,255,0.42);
  --selGlow: 0 0 0 1px rgba(10,132,255,0.18),
             0 16px 34px rgba(10,132,255,0.12);
}

/* ---------- Background ---------- */
html, body{
  margin: 0 !important;
  background: transparent !important;
  color: var(--txL) !important;
}
html{ background: var(--bgL) !important; }
@media (prefers-color-scheme: dark){
  html, body{ color: var(--txD) !important; }
  html{ background: var(--bgD) !important; }
}

/* 让应用容器透明，露出背景 */
section,
#root,
.base-container,
.MuiCssBaseline-root,
.MuiBox-root,
.MuiTypography-root{
  background: transparent !important;
}

/* 细腻一点 */
*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.1px;
}

/* ---------- Sidebar ---------- */
.MuiDrawer-paper{
  background: rgba(255,255,255,0.26) !important;
  border-right: 1px solid rgba(0,0,0,0.10) !important;
}
@media (prefers-color-scheme: dark){
  .MuiDrawer-paper{
    background: rgba(0,0,0,0.28) !important;
    border-right: 1px solid rgba(255,255,255,0.10) !important;
  }
}

/* 左侧菜单：单列 + 贴底 */
.the-menu{
  display:flex !important;
  flex-direction:column !important;
  flex-wrap:nowrap !important;
  list-style:none !important;
  padding:0 !important;
  margin:0 !important;
  gap:12px !important;
}
.the-menu li{ width:100% !important; margin:0 !important; padding:0 !important; }
.the-menu::after{ display:none !important; }

.layout__left{
  display:flex !important;
  flex-direction:column !important;
  height:100% !important;
}
.the-traffic{
  margin-top:auto !important;
  padding-top:14px !important;
}

/* 左侧选中：更像 mac 的“柔和蓝块” */
.MuiListItemButton-root{
  border-radius: var(--rs) !important;
}
.MuiListItemButton-root.Mui-selected{
  background: linear-gradient(180deg, rgba(10,132,255,0.22), rgba(10,132,255,0.14)) !important;
  border: 1px solid rgba(10,132,255,0.26) !important;
  box-shadow: 0 10px 22px rgba(10,132,255,0.14) !important;
}

/* ---------- Cards / Panels ---------- */
/* Paper / Card / Accordion 全部统一 */
.MuiPaper-root,
.MuiCard-root,
.MuiAccordion-root{
  border-radius: var(--r) !important;
  overflow: hidden !important;
  background: transparent !important;
}

/* Light panels */
@media (prefers-color-scheme: light){
  .MuiPaper-root.MuiPaper-rounded,
  .MuiCard-root,
  .MuiAccordion-root{
    background: linear-gradient(180deg, var(--panelL1), var(--panelL2)) !important;
    border: 1px solid var(--bdL) !important;
    box-shadow: var(--inL), var(--shL) !important;
  }
}
/* Dark panels */
@media (prefers-color-scheme: dark){
  .MuiPaper-root.MuiPaper-rounded,
  .MuiCard-root,
  .MuiAccordion-root{
    background: linear-gradient(180deg, var(--panelD1), var(--panelD2)) !important;
    border: 1px solid var(--bdD) !important;
    box-shadow: var(--inD), var(--shD) !important;
  }
}

/* hover 微浮起（高级感） */
.MuiPaper-root.MuiPaper-rounded:hover,
.MuiCard-root:hover,
.MuiAccordion-root:hover{
  transform: translateY(-1px);
  transition: transform .18s ease, box-shadow .18s ease;
}

/* Accordion Summary 头部更像“独立卡片头” */
.MuiAccordionSummary-root{
  border-radius: var(--r) !important;
}
@media (prefers-color-scheme: light){
  .MuiAccordionSummary-root{
    background: rgba(255,255,255,0.72) !important;
    border: 1px solid rgba(0,0,0,0.10) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiAccordionSummary-root{
    background: rgba(255,255,255,0.06) !important;
    border: 1px solid rgba(255,255,255,0.12) !important;
  }
}

/* ---------- Node Selected (整块蓝，无竖条) ---------- */
.MuiPaper-root[aria-selected="true"],
.MuiPaper-root[aria-checked="true"],
.MuiButtonBase-root[aria-selected="true"],
.MuiButtonBase-root[aria-checked="true"]{
  box-shadow: var(--selGlow) !important;
}
@media (prefers-color-scheme: light){
  .MuiPaper-root[aria-selected="true"],
  .MuiPaper-root[aria-checked="true"],
  .MuiButtonBase-root[aria-selected="true"],
  .MuiButtonBase-root[aria-checked="true"]{
    background: linear-gradient(180deg, rgba(10,132,255,0.22), rgba(10,132,255,0.14)) !important;
    border: 1px solid var(--selBdL) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiPaper-root[aria-selected="true"],
  .MuiPaper-root[aria-checked="true"],
  .MuiButtonBase-root[aria-selected="true"],
  .MuiButtonBase-root[aria-checked="true"]{
    background: linear-gradient(180deg, rgba(10,132,255,0.28), rgba(10,132,255,0.18)) !important;
    border: 1px solid var(--selBdD) !important;
  }
}

/* 去掉闪竖条（伪元素指示器） */
.MuiButtonBase-root.Mui-selected::before,
.MuiButtonBase-root.Mui-selected::after,
.MuiButtonBase-root[aria-selected="true"]::before,
.MuiButtonBase-root[aria-selected="true"]::after,
.MuiButtonBase-root[aria-checked="true"]::before,
.MuiButtonBase-root[aria-checked="true"]::after{
  content:none !important;
  display:none !important;
}

/* ---------- Chips (Trojan/UDP) iOS capsule ---------- */
.MuiChip-root,
.MuiChip-outlined,
.MuiChip-sizeSmall{
  border-radius: 999px !important;
  font-weight: 600 !important;
}
@media (prefers-color-scheme: light){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.78) !important;
    border: 1px solid rgba(0,0,0,0.16) !important;
    color: rgba(0,0,0,0.60) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.10) !important;
    border: 1px solid rgba(255,255,255,0.16) !important;
    color: rgba(255,255,255,0.82) !important;
  }
}

/* ---------- 顶部按钮组（规则/全局/直连） ---------- */
.MuiButtonGroup-root .MuiButton-root{
  border-radius: 10px !important;
  text-transform: none !important;
  font-weight: 700 !important;
}
@media (prefers-color-scheme: light){
  .MuiButtonGroup-root .MuiButton-root{
    background: rgba(255,255,255,0.72) !important;
    border: 1px solid rgba(0,0,0,0.12) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiButtonGroup-root .MuiButton-root{
    background: rgba(255,255,255,0.08) !important;
    border: 1px solid rgba(255,255,255,0.16) !important;
  }
}

/* ---------- Fix: 深色点击“延迟测试”等闪竖条 ---------- */
@media (prefers-color-scheme: dark){
  .MuiButtonBase-root.Mui-focusVisible::before,
  .MuiButtonBase-root.Mui-focusVisible::after,
  .MuiButtonBase-root:focus-visible::before,
  .MuiButtonBase-root:focus-visible::after,
  .MuiButtonBase-root:active::before,
  .MuiButtonBase-root:active::after{
    content:none !important;
    display:none !important;
  }
  .MuiButtonBase-root:focus-visible{
    outline:none !important;
    box-shadow: 0 0 0 1px rgba(10,132,255,0.18), var(--selGlow) !important;
  }
}
