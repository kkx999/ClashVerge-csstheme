/* =========================================================
   Clash Verge - Windows Only (WIN v2.0)
   修复点：
   1) 卡片和背景融合 -> 提高面板不透明度 + 强化阴影/边框
   2) 避免误伤右侧窄竖条 -> 排除超窄元素
   3) 选中态整块蓝，无竖条闪烁
   ========================================================= */

:root{
  --accent: rgba(10,132,255,1);

  --r: 18px;
  --rs: 14px;

  /* 背景压低对比（避免吃掉卡片层级） */
  --bgL:
    radial-gradient(1100px 820px at 18% 8%, rgba(160, 205, 255, 0.42), transparent 64%),
    radial-gradient(900px 700px at 82% 16%, rgba(235, 225, 255, 0.32), transparent 68%),
    linear-gradient(180deg, rgba(246, 248, 252, 0.99), rgba(232, 238, 247, 0.985));

  --bgD:
    radial-gradient(1200px 900px at 20% 12%, rgba(25, 120, 255, 0.18), transparent 68%),
    radial-gradient(900px 700px at 78% 16%, rgba(150, 120, 255, 0.10), transparent 72%),
    linear-gradient(180deg, rgba(8, 10, 14, 0.998), rgba(12, 18, 26, 0.996));

  /* 面板：Win 要更“实”（不透明度更高） */
  --panelL1: rgba(255,255,255,0.965);
  --panelL2: rgba(248,250,252,0.935);

  --panelD1: rgba(24,28,38,0.94);
  --panelD2: rgba(18,22,30,0.90);

  /* hairline + 阴影更明确 */
  --bdL: rgba(0,0,0,0.12);
  --bdD: rgba(255,255,255,0.13);

  --shL: 0 12px 30px rgba(0,0,0,0.13);
  --shD: 0 24px 70px rgba(0,0,0,0.66);

  --inL: inset 0 1px 0 rgba(255,255,255,0.85);
  --inD: inset 0 1px 0 rgba(255,255,255,0.07);

  --txL: rgba(18,22,28,0.92);
  --txD: rgba(245,247,250,0.92);

  --selBdL: rgba(10,132,255,0.38);
  --selBdD: rgba(140,190,255,0.45);
  --selGlow: 0 0 0 1px rgba(10,132,255,0.18),
             0 18px 38px rgba(10,132,255,0.14);
}

/* 背景铺到 html（最稳） */
html, body{
  margin:0 !important;
  background: transparent !important;
  color: var(--txL) !important;
}
html{ background: var(--bgL) !important; }
@media (prefers-color-scheme: dark){
  html{ background: var(--bgD) !important; }
  body{ color: var(--txD) !important; }
}

/* 容器透明露底 */
section,
#root,
.base-container,
.MuiCssBaseline-root,
.MuiBox-root,
.MuiTypography-root{
  background: transparent !important;
}

/* 字体细腻 */
*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: .1px;
}

/* ================= Sidebar（Win 结构） ================= */
.layout__left{
  background: rgba(255,255,255,0.20) !important;
  border-right: 1px solid rgba(0,0,0,0.10) !important;
}
@media (prefers-color-scheme: dark){
  .layout__left{
    background: rgba(0,0,0,0.22) !important;
    border-right: 1px solid rgba(255,255,255,0.10) !important;
  }
}

/* 单列菜单 + 贴底 */
.the-menu{
  display:flex !important;
  flex-direction:column !important;
  flex-wrap:nowrap !important;
  list-style:none !important;
  padding:0 !important;
  margin:0 !important;
  gap:12px !important;
}
.the-menu li{ width:100% !important; margin:0 !important; padding:0 !important; }
.the-menu::after{ display:none !important; }

.layout__left{ display:flex !important; flex-direction:column !important; height:100% !important; }
.the-traffic{ margin-top:auto !important; padding-top:14px !important; }

/* 左侧选中 */
.layout__left .Mui-selected,
.layout__left [aria-selected="true"]{
  border-radius: var(--rs) !important;
  background: linear-gradient(180deg, rgba(10,132,255,0.22), rgba(10,132,255,0.14)) !important;
  border: 1px solid rgba(10,132,255,0.26) !important;
  box-shadow: 0 10px 22px rgba(10,132,255,0.14) !important;
}

/* =========================================================
   核心：只把“紫框那类卡片”（role=button 且不是窄竖条）做成卡片材质
   - 排除：宽度很窄、只有图标的竖条（你右侧那条彩色竖栏）
   ========================================================= */

/* 1) 定义“卡片候选”：主内容区的 role=button */
.base-container :not(.layout__left) div[role="button"]{
  border-radius: var(--r) !important;
}

/* 2) 排除窄竖条（通常宽度很小、且高度很长/只有一个图标）
      这里用：如果里面只有 0~1 个 svg/img 并且文本很少，就不要套卡片材质。
      （CSS 不能直接算文本长度，所以用结构排除：窄条常见是只有 svg 或 img） */
.base-container :not(.layout__left) div[role="button"]:has(> svg):not(:has(span, p, h1, h2, h3, h4, h5, h6)),
.base-container :not(.layout__left) div[role="button"]:has(> img):not(:has(span, p, h1, h2, h3, h4, h5, h6)){
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* 3) 真正卡片（包含文字/布局）上材质 */
@media (prefers-color-scheme: light){
  .base-container :not(.layout__left) div[role="button"]:has(span, p, h1, h2, h3, h4, h5, h6){
    background: linear-gradient(180deg, var(--panelL1), var(--panelL2)) !important;
    border: 1px solid var(--bdL) !important;
    box-shadow: var(--inL), var(--shL) !important;
    overflow: hidden !important;
  }
}
@media (prefers-color-scheme: dark){
  .base-container :not(.layout__left) div[role="button"]:has(span, p, h1, h2, h3, h4, h5, h6){
    background: linear-gradient(180deg, var(--panelD1), var(--panelD2)) !important;
    border: 1px solid var(--bdD) !important;
    box-shadow: var(--inD), var(--shD) !important;
    overflow: hidden !important;
  }
}

/* hover 微浮起 */
.base-container :not(.layout__left) div[role="button"]:has(span, p, h1, h2, h3, h4, h5, h6):hover{
  transform: translateY(-1px);
  transition: transform .18s ease, box-shadow .18s ease;
}

/* ================= 选中态：整块蓝，无竖条 ================= */
@media (prefers-color-scheme: light){
  .base-container :not(.layout__left) div[role="button"].Mui-selected,
  .base-container :not(.layout__left) div[role="button"][aria-selected="true"],
  .base-container :not(.layout__left) div[role="button"][aria-checked="true"]{
    background: linear-gradient(180deg, rgba(10,132,255,0.22), rgba(10,132,255,0.14)) !important;
    border: 1px solid var(--selBdL) !important;
    box-shadow: var(--selGlow) !important;
  }
}
@media (prefers-color-scheme: dark){
  .base-container :not(.layout__left) div[role="button"].Mui-selected,
  .base-container :not(.layout__left) div[role="button"][aria-selected="true"],
  .base-container :not(.layout__left) div[role="button"][aria-checked="true"]{
    background: linear-gradient(180deg, rgba(10,132,255,0.30), rgba(10,132,255,0.18)) !important;
    border: 1px solid var(--selBdD) !important;
    box-shadow: var(--selGlow) !important;
  }
}

/* 干掉竖条/闪一下的伪元素 */
.base-container :not(.layout__left) div[role="button"]::before,
.base-container :not(.layout__left) div[role="button"]::after{
  content:none !important;
  display:none !important;
}

/* 深色 focus/active 也别闪竖条 */
@media (prefers-color-scheme: dark){
  .base-container :not(.layout__left) div[role="button"]:focus-visible{
    outline: none !important;
    box-shadow: 0 0 0 1px rgba(10,132,255,0.18), var(--selGlow) !important;
  }
}

/* ================= Chip 胶囊（如果存在） ================= */
.MuiChip-root,
.MuiChip-outlined,
.MuiChip-sizeSmall{
  border-radius: 999px !important;
  font-weight: 600 !important;
}
@media (prefers-color-scheme: light){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.86) !important;
    border: 1px solid rgba(0,0,0,0.16) !important;
    color: rgba(0,0,0,0.62) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.10) !important;
    border: 1px solid rgba(255,255,255,0.16) !important;
    color: rgba(255,255,255,0.84) !important;
  }
}
