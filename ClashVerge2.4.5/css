/* =========================================================
   Apple-like Premium Glass v2.6 (Cross-platform)
   - 重点：减少依赖 .css-xxxxx（hash 类名跨平台会变）
   - 改用 MUI 稳定选择器 + prefers-color-scheme
   - ✅ 左侧单列 ✅ 流量区贴底 ✅ 选中无竖条 ✅ 深色点击闪竖条修复 ✅ iOS capsule 标签
   ========================================================= */

:root{
  --accent: rgba(10, 132, 255, 1);

  --radius: 18px;
  --radius-sm: 14px;
  --blur: 14px;

  /* 页面底色：解决圆角黑边 */
  --page-light: #eef2f7;
  --page-dark:  #0a0e15;

  /* 背景（直接作用于 body/base-container，避免依赖 hash 容器） */
  --bg-light:
    radial-gradient(1200px 900px at 18% 10%, rgba(185, 218, 255, 0.50), transparent 62%),
    radial-gradient(900px 700px at 82% 18%, rgba(235, 230, 255, 0.34), transparent 66%),
    linear-gradient(180deg, rgba(245, 248, 252, 0.98), rgba(234, 240, 248, 0.96));

  --bg-dark:
    radial-gradient(1200px 900px at 20% 12%, rgba(30, 115, 255, 0.18), transparent 66%),
    radial-gradient(900px 700px at 78% 18%, rgba(150, 120, 255, 0.09), transparent 70%),
    radial-gradient(900px 700px at 60% 82%, rgba(60, 220, 200, 0.05), transparent 74%),
    linear-gradient(180deg, rgba(6, 9, 14, 0.995), rgba(10, 16, 26, 0.985));

  /* 玻璃材质 */
  --glass-light: rgba(255,255,255,0.16);
  --glass-light-strong: rgba(255,255,255,0.22);
  --glass-dark: rgba(14, 18, 26, 0.54);
  --glass-dark-strong: rgba(14, 18, 26, 0.62);

  /* hairline 边框 */
  --stroke-light: rgba(0,0,0,0.055);
  --stroke-dark: rgba(255,255,255,0.085);

  /* 内高光 */
  --inner-light: inset 0 1px 0 rgba(255,255,255,0.70);
  --inner-dark:  inset 0 1px 0 rgba(255,255,255,0.055);

  /* 阴影 */
  --shadow-light: 0 8px 18px rgba(0,0,0,0.08);   /* 更克制 */
  --shadow-dark:  0 16px 42px rgba(0,0,0,0.42);

  /* 文本 */
  --text-light: rgba(18, 22, 28, 0.94);
  --text-dark: rgba(245, 247, 250, 0.92);

  /* 选中态 */
  --sel-light: rgba(10,132,255,0.18);
  --sel-dark:  rgba(10,132,255,0.28);
  --sel-border-light: rgba(10,132,255,0.38);
  --sel-border-dark:  rgba(140, 190, 255, 0.44);
  --sel-glow: 0 0 0 1px rgba(10,132,255,0.20),
              0 12px 26px rgba(10,132,255,0.12);
}

/* ============ 1) 基础修复 & 背景（跨平台） ============ */
html, body{
  margin: 0 !important;
  background: var(--page-light) !important;
  color: var(--text-light) !important;
}
@media (prefers-color-scheme: dark){
  html, body{
    background: var(--page-dark) !important;
    color: var(--text-dark) !important;
  }
}

/* 直接把背景铺到 body，避免依赖 .css-xxxxx 容器 */
body{
  background-image: var(--bg-light) !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
}
@media (prefers-color-scheme: dark){
  body{
    background-image: var(--bg-dark) !important;
  }
}

/* 让应用主容器透明，露出 body 背景 */
section,
.base-container,
.MuiBox-root,
.MuiTypography-root{
  background-color: transparent !important;
}

/* 字体更细腻 */
*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.1px;
}

/* 滚动条低存在感 */
::-webkit-scrollbar{ width: 10px; height: 10px; }
::-webkit-scrollbar-thumb{
  background: rgba(140,140,140,0.26);
  border-radius: 999px;
  border: 3px solid rgba(0,0,0,0);
  background-clip: padding-box;
}
::-webkit-scrollbar-thumb:hover{ background: rgba(140,140,140,0.40); }

/* ============ 2) 左侧菜单：单列 + 贴底（稳定类/结构） ============ */
.the-menu{
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style-type: none !important;
  gap: 12px;
}
.the-menu li{
  width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}
.the-menu::after{ display:none !important; }

.layout__left{
  height: 100% !important;
  flex: 1 0 400px !important;
  display: flex !important;
  flex-direction: column !important;
}
.the-traffic{
  margin-top: auto !important;
  padding-top: 14px !important;
}

/* 侧边栏选中（用 MUI 稳定类） */
.MuiListItemButton-root.Mui-selected{
  background-color: rgba(10,132,255,0.15) !important;
  border: 1px solid rgba(10,132,255,0.20) !important;
  border-radius: var(--radius-sm) !important;
  backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
  -webkit-backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
}

/* ============ 3) 卡片 / 面板：用 MuiPaper 统一玻璃风格（跨平台稳定） ============ */
/* 常见卡片基本都是 Paper（rounded + elevation0/1），统一圆角 */
.MuiPaper-root{
  border-radius: var(--radius) !important;
  background-color: transparent !important;
}

/* 浅色 Paper 玻璃 */
@media (prefers-color-scheme: light){
  .MuiPaper-root.MuiPaper-rounded{
    background-color: var(--glass-light) !important;
    border: 1px solid var(--stroke-light) !important;
    box-shadow: var(--inner-light), var(--shadow-light) !important;
    backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
  }
}

/* 深色 Paper 玻璃 */
@media (prefers-color-scheme: dark){
  .MuiPaper-root.MuiPaper-rounded{
    background-color: var(--glass-dark) !important;
    border: 1px solid var(--stroke-dark) !important;
    box-shadow: var(--inner-dark), var(--shadow-dark) !important;
    backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
    -webkit-backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
  }
}

/* hover 稍微浮起来 */
.MuiPaper-root.MuiPaper-rounded:hover{
  transform: translateY(-1px);
  transition: transform .18s ease, box-shadow .18s ease;
}

/* ============ 4) 节点选中：整块蓝（不靠 hash） ============ */
/* 通过 aria-selected/checked 兼容节点列表的选中态 */
[aria-selected="true"],
[aria-checked="true"]{
  box-shadow: var(--sel-glow) !important;
}

/* 浅色选中 */
@media (prefers-color-scheme: light){
  [aria-selected="true"],
  [aria-checked="true"]{
    background-color: var(--sel-light) !important;
    border: 1px solid var(--sel-border-light) !important;
  }
}

/* 深色选中 */
@media (prefers-color-scheme: dark){
  [aria-selected="true"],
  [aria-checked="true"]{
    background-color: var(--sel-dark) !important;
    border: 1px solid var(--sel-border-dark) !important;
  }
}

/* 去掉可能出现的“左侧竖条”（伪元素方式） */
[aria-selected="true"]::before,
[aria-selected="true"]::after,
[aria-checked="true"]::before,
[aria-checked="true"]::after{
  content: none !important;
  display: none !important;
}

/* ============ 5) 标签（Trojan/UDP）→ iOS capsule（跨平台稳定） ============ */
.MuiChip-root,
.MuiChip-outlined,
.MuiChip-sizeSmall{
  border-radius: 999px !important;
  backdrop-filter: blur(8px) saturate(1.04) !important;
  -webkit-backdrop-filter: blur(8px) saturate(1.04) !important;
}

/* 浅色：更清晰 */
@media (prefers-color-scheme: light){
  .MuiChip-root,
  .MuiChip-outlined{
    background-color: rgba(255,255,255,0.42) !important;
    border: 1px solid rgba(0,0,0,0.10) !important;
    color: rgba(0,0,0,0.62) !important;
  }
}

/* 深色：更玻璃、更统一 */
@media (prefers-color-scheme: dark){
  .MuiChip-root,
  .MuiChip-outlined{
    background-color: rgba(255,255,255,0.07) !important;
    border: 1px solid rgba(255,255,255,0.14) !important;
    color: rgba(255,255,255,0.78) !important;
  }
}

/* ============ 6) DataGrid：透明 + 轻毛玻璃（若存在） ============ */
.MuiDataGrid-root{
  background: transparent !important;
}
.MuiDataGrid-main,
.MuiDataGrid-columnHeaders{
  background: transparent !important;
}

/* ============ 7) 修复：深色模式点击“延迟测试”等闪竖条 ============ */
@media (prefers-color-scheme: dark){
  .MuiButtonBase-root.Mui-selected::before,
  .MuiButtonBase-root.Mui-selected::after,
  .MuiButtonBase-root.Mui-focusVisible::before,
  .MuiButtonBase-root.Mui-focusVisible::after,
  .MuiButtonBase-root:focus-visible::before,
  .MuiButtonBase-root:focus-visible::after,
  .MuiButtonBase-root:active::before,
  .MuiButtonBase-root:active::after,
  .MuiListItemButton-root.Mui-selected::before,
  .MuiListItemButton-root.Mui-selected::after,
  .MuiListItemButton-root:active::before,
  .MuiListItemButton-root:active::after{
    content: none !important;
    display: none !important;
  }

  .MuiButtonBase-root.Mui-selected,
  .MuiButtonBase-root[aria-selected="true"],
  .MuiButtonBase-root[aria-checked="true"],
  .MuiListItemButton-root.Mui-selected{
    border-left: 0 !important;
    box-shadow: var(--sel-glow) !important;
  }

  /* 很淡的苹果式 focus ring */
  .MuiButtonBase-root:focus-visible{
    outline: none !important;
    box-shadow: 0 0 0 1px rgba(10,132,255,0.18), var(--sel-glow) !important;
  }
}

/* ============ 8) 兼容：如果部分 hash 类仍存在（mac 上命中也不冲突） ============ */
/* 你之前用过的容器类（有就命中，没有也不影响） */
.css-1li7dvq, .css-l3ykv8{ background-color: transparent !important; }
