/* =========================================================
   Clash Verge Windows Theme - Premium Glass (WIN v1.0)
   仅用于 Windows：不依赖 .css-xxxx hash 类名，保证命中稳定
   - ✅ 背景统一（暗/亮都高级）
   - ✅ 卡片/Paper/Accordion 统一玻璃质感（支持 blur 有就上）
   - ✅ 节点选中更明显（无左侧竖条）
   - ✅ 标签 iOS capsule
   - ✅ 左侧单列 + 流量区贴底
   - ✅ 修复深色点击“延迟测试”等闪竖条
   ========================================================= */

/* ---------- 变量 ---------- */
:root{
  --accent: rgba(10,132,255,1);

  --radius: 18px;
  --radius-sm: 14px;

  /* Windows 下建议更“实”一点，避免 blur 不工作时太虚 */
  --glass-blur: 16px;
  --glass-sat: 1.06;

  --stroke-light: rgba(0,0,0,0.08);
  --stroke-dark: rgba(255,255,255,0.10);

  --shadow-light: 0 10px 26px rgba(0,0,0,0.10);
  --shadow-dark:  0 18px 50px rgba(0,0,0,0.55);

  --text-light: rgba(18, 22, 28, 0.92);
  --text-dark:  rgba(245, 247, 250, 0.92);

  /* 背景 */
  --bg-light:
    radial-gradient(1100px 820px at 18% 10%, rgba(185, 220, 255, 0.55), transparent 62%),
    radial-gradient(900px 700px at 82% 18%, rgba(230, 225, 255, 0.38), transparent 66%),
    linear-gradient(180deg, rgba(246, 248, 252, 0.98), rgba(233, 239, 247, 0.96));

  --bg-dark:
    radial-gradient(1100px 820px at 20% 12%, rgba(30, 115, 255, 0.22), transparent 66%),
    radial-gradient(900px 700px at 78% 18%, rgba(150, 120, 255, 0.12), transparent 70%),
    linear-gradient(180deg, rgba(8, 10, 14, 0.995), rgba(12, 18, 26, 0.985));

  /* 面板色（Win 更稳：更不透明） */
  --panel-light: rgba(255,255,255,0.78);
  --panel-light-strong: rgba(255,255,255,0.88);
  --panel-dark: rgba(20, 24, 32, 0.78);
  --panel-dark-strong: rgba(20, 24, 32, 0.88);

  /* 选中态 */
  --sel-light: rgba(10,132,255,0.16);
  --sel-dark:  rgba(10,132,255,0.26);
  --sel-border-light: rgba(10,132,255,0.34);
  --sel-border-dark:  rgba(140,190,255,0.40);
  --sel-glow: 0 0 0 1px rgba(10,132,255,0.18), 0 14px 30px rgba(10,132,255,0.10);
}

/* ---------- 背景：用 body::before 固定铺底，避免被容器覆盖 ---------- */
html, body{
  margin: 0 !important;
  background: transparent !important;
}
body::before{
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background: var(--bg-light);
}
@media (prefers-color-scheme: dark){
  body::before{ background: var(--bg-dark); }
}

/* 文字颜色 */
body{ color: var(--text-light) !important; }
@media (prefers-color-scheme: dark){
  body{ color: var(--text-dark) !important; }
}

/* 让应用主容器透明，露出背景（Win 关键） */
section,
.base-container,
#root,
.MuiCssBaseline-root,
.MuiBox-root,
.MuiTypography-root{
  background: transparent !important;
}

/* 字体更细腻 */
*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.1px;
}

/* ---------- 左侧菜单：单列 + 贴底 ---------- */
.the-menu{
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  gap: 12px !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
}
.the-menu li{
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}
.the-menu::after{ display:none !important; }

.layout__left{
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  flex: 1 0 400px !important;
}
.the-traffic{
  margin-top: auto !important;
  padding-top: 14px !important;
}

/* ---------- Drawer（左侧栏）更像 macOS sidebar ---------- */
.MuiDrawer-paper{
  border-right: 1px solid rgba(255,255,255,0.06) !important;
  background: rgba(0,0,0,0.10) !important;
}
@media (prefers-color-scheme: light){
  .MuiDrawer-paper{
    border-right: 1px solid rgba(0,0,0,0.06) !important;
    background: rgba(255,255,255,0.10) !important;
  }
}

/* 侧边栏选中 */
.MuiListItemButton-root.Mui-selected{
  border-radius: var(--radius-sm) !important;
  background-color: rgba(10,132,255,0.16) !important;
  border: 1px solid rgba(10,132,255,0.22) !important;
}

/* ---------- 卡片/节点/面板：Paper + Accordion 统一玻璃 ---------- */
.MuiPaper-root,
.MuiAccordion-root{
  border-radius: var(--radius) !important;
  background: transparent !important;
  overflow: hidden !important;
}

/* Light */
@media (prefers-color-scheme: light){
  .MuiPaper-root.MuiPaper-rounded,
  .MuiAccordion-root{
    background-color: var(--panel-light) !important;
    border: 1px solid var(--stroke-light) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.70), var(--shadow-light) !important;
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat)) !important;
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat)) !important;
  }
}

/* Dark */
@media (prefers-color-scheme: dark){
  .MuiPaper-root.MuiPaper-rounded,
  .MuiAccordion-root{
    background-color: var(--panel-dark) !important;
    border: 1px solid var(--stroke-dark) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), var(--shadow-dark) !important;
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat)) !important;
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat)) !important;
  }
}

/* Accordion Summary 也做成“卡片头” */
.MuiAccordionSummary-root{
  border-radius: var(--radius) !important;
}
@media (prefers-color-scheme: light){
  .MuiAccordionSummary-root{
    background-color: var(--panel-light-strong) !important;
    border: 1px solid rgba(0,0,0,0.07) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiAccordionSummary-root{
    background-color: var(--panel-dark-strong) !important;
    border: 1px solid rgba(255,255,255,0.09) !important;
  }
}

/* hover 稍微浮起 */
.MuiPaper-root.MuiPaper-rounded:hover,
.MuiAccordion-root:hover{
  transform: translateY(-1px);
  transition: transform .18s ease, box-shadow .18s ease;
}

/* ---------- 节点选中（无竖条） ---------- */
/* 只对“看起来像卡片/条目”的目标更安全：Paper / ButtonBase / ListItemButton */
.MuiPaper-root[aria-selected="true"],
.MuiPaper-root[aria-checked="true"],
.MuiButtonBase-root[aria-selected="true"],
.MuiButtonBase-root[aria-checked="true"],
.MuiListItemButton-root.Mui-selected{
  box-shadow: var(--sel-glow) !important;
}

/* Light 选中 */
@media (prefers-color-scheme: light){
  .MuiPaper-root[aria-selected="true"],
  .MuiPaper-root[aria-checked="true"],
  .MuiButtonBase-root[aria-selected="true"],
  .MuiButtonBase-root[aria-checked="true"]{
    background-color: var(--sel-light) !important;
    border: 1px solid var(--sel-border-light) !important;
  }
}

/* Dark 选中 */
@media (prefers-color-scheme: dark){
  .MuiPaper-root[aria-selected="true"],
  .MuiPaper-root[aria-checked="true"],
  .MuiButtonBase-root[aria-selected="true"],
  .MuiButtonBase-root[aria-checked="true"]{
    background-color: var(--sel-dark) !important;
    border: 1px solid var(--sel-border-dark) !important;
  }
}

/* 干掉任何左侧竖条伪元素 */
.MuiButtonBase-root::before,
.MuiButtonBase-root::after{
  /* 只清理“指示器类”的，避免影响真实内容 */
}
.MuiButtonBase-root.Mui-selected::before,
.MuiButtonBase-root.Mui-selected::after,
.MuiButtonBase-root[aria-selected="true"]::before,
.MuiButtonBase-root[aria-selected="true"]::after,
.MuiButtonBase-root[aria-checked="true"]::before,
.MuiButtonBase-root[aria-checked="true"]::after{
  content: none !important;
  display: none !important;
}

/* ---------- 标签（Trojan/UDP）= iOS capsule ---------- */
.MuiChip-root,
.MuiChip-outlined,
.MuiChip-sizeSmall{
  border-radius: 999px !important;
  backdrop-filter: blur(10px) saturate(1.05) !important;
  -webkit-backdrop-filter: blur(10px) saturate(1.05) !important;
}

/* Light */
@media (prefers-color-scheme: light){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.55) !important;
    border: 1px solid rgba(0,0,0,0.12) !important;
    color: rgba(0,0,0,0.62) !important;
  }
}
/* Dark */
@media (prefers-color-scheme: dark){
  .MuiChip-root,
  .MuiChip-outlined{
    background: rgba(255,255,255,0.08) !important;
    border: 1px solid rgba(255,255,255,0.14) !important;
    color: rgba(255,255,255,0.78) !important;
  }
}

/* ---------- 顶部按钮组（规则/全局/直连）更像 segmented control ---------- */
.MuiButtonGroup-root .MuiButton-root{
  border-radius: 10px !important;
  text-transform: none !important;
}
@media (prefers-color-scheme: light){
  .MuiButtonGroup-root .MuiButton-root{
    background: rgba(255,255,255,0.55) !important;
    border: 1px solid rgba(0,0,0,0.12) !important;
  }
}
@media (prefers-color-scheme: dark){
  .MuiButtonGroup-root .MuiButton-root{
    background: rgba(255,255,255,0.06) !important;
    border: 1px solid rgba(255,255,255,0.14) !important;
  }
}

/* ---------- 修复：深色模式点击“延迟测试”等闪竖条（active/focus 指示器） ---------- */
@media (prefers-color-scheme: dark){
  .MuiButtonBase-root.Mui-selected::before,
  .MuiButtonBase-root.Mui-selected::after,
  .MuiButtonBase-root.Mui-focusVisible::before,
  .MuiButtonBase-root.Mui-focusVisible::after,
  .MuiButtonBase-root:focus-visible::before,
  .MuiButtonBase-root:focus-visible::after,
  .MuiButtonBase-root:active::before,
  .MuiButtonBase-root:active::after,
  .MuiListItemButton-root.Mui-selected::before,
  .MuiListItemButton-root.Mui-selected::after,
  .MuiListItemButton-root:active::before,
  .MuiListItemButton-root:active::after{
    content: none !important;
    display: none !important;
  }

  .MuiButtonBase-root:focus-visible{
    outline: none !important;
    box-shadow: 0 0 0 1px rgba(10,132,255,0.18), var(--sel-glow) !important;
  }
}
