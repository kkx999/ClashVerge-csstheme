/* =========================================================
   Apple-like Premium Glass
   ========================================================= */

:root{
  --accent: rgba(10, 132, 255, 1);

  --radius: 18px;
  --radius-sm: 14px;
  --blur: 14px;

  /* 页面底色：解决圆角黑边 */
  --page-light: #eef2f7;
  --page-dark:  #0a0e15;

  /* 背景：浅色更柔，深色更沉稳 */
  --bg-light:
    radial-gradient(1200px 900px at 18% 10%, rgba(185, 218, 255, 0.50), transparent 62%),
    radial-gradient(900px 700px at 82% 18%, rgba(235, 230, 255, 0.34), transparent 66%),
    linear-gradient(180deg, rgba(245, 248, 252, 0.98), rgba(234, 240, 248, 0.96));

  --bg-dark:
    radial-gradient(1200px 900px at 20% 12%, rgba(30, 115, 255, 0.18), transparent 66%),
    radial-gradient(900px 700px at 78% 18%, rgba(150, 120, 255, 0.09), transparent 70%),
    radial-gradient(900px 700px at 60% 82%, rgba(60, 220, 200, 0.05), transparent 74%),
    linear-gradient(180deg, rgba(6, 9, 14, 0.995), rgba(10, 16, 26, 0.985));

  /* 玻璃材质 */
  --glass-light: rgba(255,255,255,0.16);
  --glass-light-strong: rgba(255,255,255,0.22);

  --glass-dark: rgba(14, 18, 26, 0.54);
  --glass-dark-strong: rgba(14, 18, 26, 0.62);

  /* hairline 边框 */
  --stroke-light: rgba(0,0,0,0.055);
  --stroke-dark: rgba(255,255,255,0.085);

  /* 内高光 */
  --inner-light: inset 0 1px 0 rgba(255,255,255,0.60);
  --inner-dark:  inset 0 1px 0 rgba(255,255,255,0.055);

  /* 阴影 */
  --shadow-1: 0 10px 22px rgba(0,0,0,0.10);
  --shadow-2: 0 16px 34px rgba(0,0,0,0.16);

  /* 文本 */
  --text-light: rgba(18, 22, 28, 0.94);
  --text-dark: rgba(245, 247, 250, 0.92);

  /* 选中态（浅色更明显） */
  --sel-light: rgba(10,132,255,0.18);
  --sel-dark:  rgba(10,132,255,0.28);
  --sel-border-light: rgba(10,132,255,0.38);
  --sel-border-dark:  rgba(140, 190, 255, 0.44);
  --sel-glow: 0 0 0 1px rgba(10,132,255,0.20),
              0 12px 26px rgba(10,132,255,0.12);
}

/* ============ 1) 修复两角黑边 ============ */
html, body{
  margin: 0 !important;
  background: var(--page-light) !important;
}
@media (prefers-color-scheme: dark){
  html, body{ background: var(--page-dark) !important; }
}

/* 字体渲染更细腻 */
*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.1px;
}

/* 滚动条低存在感 */
::-webkit-scrollbar{ width: 10px; height: 10px; }
::-webkit-scrollbar-thumb{
  background: rgba(140,140,140,0.26);
  border-radius: 999px;
  border: 3px solid rgba(0,0,0,0);
  background-clip: padding-box;
}
::-webkit-scrollbar-thumb:hover{ background: rgba(140,140,140,0.40); }

/* ============ 2) 根背景 ============ */
section{ background-color: transparent !important; }
html{ --background-color: #0000 !important; }

.css-1li7dvq{
  background-image: var(--bg-light) !important;
  background-color: transparent !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  color: var(--text-light) !important;
  position: relative;
}
.css-l3ykv8{
  background-image: var(--bg-dark) !important;
  background-color: transparent !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  color: var(--text-dark) !important;
  position: relative;
}

/* 可读性蒙层 */
.css-1li7dvq::before,
.css-l3ykv8::before{
  content:"";
  position:absolute; inset:0;
  pointer-events:none;
}
.css-1li7dvq::before{
  background: linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.03));
}
.css-l3ykv8::before{
  background: linear-gradient(180deg, rgba(0,0,0,0.16), rgba(0,0,0,0.10));
}
.css-1li7dvq > *, .css-l3ykv8 > *{ position: relative; }

/* ============ 3) 全局透明（保留） ============ */
.MuiBox-root{ background-color: transparent !important; }
.base-container{ background-color: transparent !important; }
.MuiTypography-root{ background-color: transparent !important; }

/* ============ 4) 左侧菜单：单列一行一个 + 流量区贴底（A） ============ */
.the-menu{
  display: flex !important;
  flex-direction: column !important;
  flex-wrap: nowrap !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style-type: none !important;
  gap: 12px;
}
.the-menu li{
  width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}
.the-menu::after{ display:none !important; }

/* 左侧容器改为纵向布局，底部流量区自动贴底 */
.layout__left{
  height: 100% !important;
  flex: 1 0 400px !important;
  display: flex !important;
  flex-direction: column !important;
}

.the-traffic{
  margin-top: auto !important;   /* 关键：贴底 */
  padding-top: 14px !important;
}

/* 侧边栏选中：干净克制 */
.css-a7awl9.Mui-selected,
.css-1pqmd8p.Mui-selected{
  background-color: rgba(10,132,255,0.15) !important;
  border: 1px solid rgba(10,132,255,0.20) !important;
  border-radius: var(--radius-sm) !important;
  backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
  -webkit-backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
}
.css-a7awl9 span,
.css-1pqmd8p span{
  text-shadow: none !important;
}

/* ============ 5) 快捷按钮：薄 frosted 控件 ============ */
.css-buo882, .css-1woqkq7,
.css-6892g4, .css-1j1wdi0{
  border-radius: var(--radius-sm) !important;
  backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
  -webkit-backdrop-filter: blur(calc(var(--blur) - 4px)) saturate(1.04) !important;
  transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease;
}
.css-buo882, .css-1woqkq7{
  background-color: rgba(255,255,255,0.16) !important;
  border: 1px solid var(--stroke-light) !important;
  box-shadow: var(--inner-light), var(--shadow-1) !important;
}
.css-6892g4, .css-1j1wdi0{
  background-color: rgba(14,18,26,0.44) !important;
  border: 1px solid var(--stroke-dark) !important;
  box-shadow: var(--inner-dark), var(--shadow-1) !important;
}
.css-buo882:hover, .css-1woqkq7:hover,
.css-6892g4:hover, .css-1j1wdi0:hover{
  transform: translateY(-1px);
  box-shadow: var(--shadow-2) !important;
}

/* 首页按钮选中 */
.css-14aadh2, .css-1dxee5s{
  background-color: rgba(10,132,255,0.94) !important;
  color: #fff !important;
  box-shadow: 0 12px 26px rgba(10,132,255,0.24) !important;
}

/* ============ 6) 节点/条目卡片：精修质感 ============ */
.css-n8e8d, .css-1d9xrv7, .css-9kkeku,
.css-jtgpy6, .css-1mxksna,
.css-14wd3ve, .css-23cvz{
  border-radius: var(--radius) !important;
  backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
  -webkit-backdrop-filter: blur(var(--blur)) saturate(1.08) !important;
  transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease, border-color .18s ease;
}

/* Light 卡片 */
.css-1li7dvq .css-n8e8d,
.css-1li7dvq .css-1d9xrv7,
.css-1li7dvq .css-9kkeku,
.css-1li7dvq .css-14wd3ve,
.css-1li7dvq .css-23cvz{
  background-color: var(--glass-light) !important;
  border: 1px solid var(--stroke-light) !important;
  box-shadow: var(--inner-light), var(--shadow-1) !important;
}

/* Dark 卡片 */
.css-l3ykv8 .css-jtgpy6,
.css-l3ykv8 .css-1mxksna,
.css-l3ykv8 .css-9kkeku,
.css-l3ykv8 .css-14wd3ve,
.css-l3ykv8 .css-23cvz{
  background-color: var(--glass-dark) !important;
  border: 1px solid var(--stroke-dark) !important;
  box-shadow: var(--inner-dark), 0 16px 42px rgba(0,0,0,0.42) !important;
}

.css-n8e8d:hover, .css-1d9xrv7:hover, .css-9kkeku:hover,
.css-jtgpy6:hover, .css-1mxksna:hover{
  transform: translateY(-1px);
  box-shadow: var(--shadow-2) !important;
}

